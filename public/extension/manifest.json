{
  "manifest_version": 3,
  "name": "RasaWeb Agent — Messaging Hub",
  "short_name": "RasaWeb Agent",
  "version": "1.2.7",
  "minimum_chrome_version": "114",
  "description": "عامل اجرایی مرورگر RasaWeb — دریافت دستور از پنل مرکزی و اجرای مجاز در محیط واقعی پیام‌رسان‌ها",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "notifications",
    "alarms",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://rubika.ir/*",
    "https://web.rubika.ir/*",
    "https://web.bale.ai/*",
    "https://eitaa.com/*",
    "https://web.eitaa.com/*",
    "https://soroush.plus/*",
    "https://web.soroush.plus/*",
    "https://messenger.soroush.plus/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "RasaWeb Agent",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://rubika.ir/*",
        "https://web.rubika.ir/*",
        "https://web.bale.ai/*",
        "https://eitaa.com/*",
        "https://web.eitaa.com/*",
        "https://soroush.plus/*",
        "https://web.soroush.plus/*",
        "https://messenger.soroush.plus/*"
      ],
      "js": [
        "content/adapters.js",
        "content/agent.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}